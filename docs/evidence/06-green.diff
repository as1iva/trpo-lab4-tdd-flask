diff --git a/todo/__init__.py b/todo/__init__.py
index a3dca09..7b4904e 100644
--- a/todo/__init__.py
+++ b/todo/__init__.py
@@ -19,6 +19,12 @@ def create_app(config=None):
         next_id += 1
